# ─── Server ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexus
DB_USER=nexus_user
DB_PASSWORD=your_db_password_here

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your_very_long_random_jwt_secret_here
JWT_EXPIRES_IN=7d

# ─── Google Gemini ───────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── File Upload ─────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# ─── Frontend URL (for CORS) ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── DigitalOcean Spaces (Phase 2 — leave blank for now) ─────────────────────
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_ENDPOINT=
DO_SPACES_BUCKET=
DO_SPACES_REGION=
